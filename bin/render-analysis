# ---------------------------------------------------------------------------
# Main HTML assembly
# ---------------------------------------------------------------------------

def render_story(summary: Any) -> str:
    """Render the structured 'story' section: headline + two-column bullets."""
    if not isinstance(summary, dict):
        return '<div class="story-headline"><em class="muted">No summary.</em></div>'
    headline = esc_h(summary.get("headline", ""))
    working = [esc_h(x) for x in (summary.get("whats_working") or []) if x]
    concerning = [esc_h(x) for x in (summary.get("whats_concerning") or []) if x]
    parts: list[str] = []
    if headline:
        parts.append(f'<div class="story-headline">{headline}</div>')
    if working or concerning:
        parts.append('<div class="story-grid">')
        if working:
            items = "".join(f'<li>{w}</li>' for w in working)
            parts.append(
                f'<div class="story-col story-working">'
                f'<div class="story-col-head">✓ What&#39;s working</div>'
                f'<ul>{items}</ul></div>'
            )
        if concerning:
            items = "".join(f'<li>{c}</li>' for c in concerning)
            parts.append(
                f'<div class="story-col story-concerning">'
                f'<div class="story-col-head">⚠ What needs attention</div>'
                f'<ul>{items}</ul></div>'
            )
        parts.append('</div>')
    if not parts:
        return '<div class="story-headline"><em class="muted">No summary.</em></div>'
    return "".join(parts)


def render_html(data: dict, raw: dict | None, metrics: dict | None = None) -> str:
    generated_at = fmt_iso_date(data.get("generated_at"))
    window = esc(data.get("window_days", ""))
    profile = esc_h((data.get("athlete") or {}).get("profile_excerpt", ""))
    summary = data.get("executive_summary")
    kpis = data.get("kpis") or []
    recs = data.get("recommendations") or []
    experts = data.get("experts") or {}
    questions = data.get("open_questions") or []
    plan_info = data.get("plan") or {}

    plan_banner = ""
    if plan_info:
        plan_banner = f"""
        <div class="plan-banner">
          <strong>Following:</strong> {esc(plan_info.get('name',''))}
          {f' · {esc(plan_info.get("source",""))}' if plan_info.get('source') else ''}
          {f' · <strong>Week {esc(plan_info.get("current_week",""))}</strong>' if plan_info.get('current_week') else ''}
        </div>
        """

    since_block = render_since_last_run(data)

    nav_links = ['<a href="#today">Today</a>']
    if since_block:
        nav_links.append('<a href="#since-last">Since last run</a>')
    nav_links.append('<a href="#summary">Summary</a>')
    if extract_season_context(data):
        nav_links.append('<a href="#roadmap">Roadmap</a>')
    nav_links += [
        '<a href="#kpis">Key numbers</a>',
        '<a href="#actions">Actions</a>',
    ]
    if raw:
        nav_links.append('<a href="#charts">Charts</a>')
    nav_links += [
        '<a href="#experts">Deep dives</a>',
        '<a href="#open-questions">Open questions</a>',
        '<a href="#glossary">Glossary</a>',
    ]

    html_body = f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>peak-lab training analysis</title>
  <style>{CSS}</style>
</head>
<body>
  <div class="wrap">
    <header class="masthead">
      <h1>Training analysis</h1>
      <div class="meta">Generated {generated_at} · {window}-day window</div>
      {plan_banner}
      <nav class="anchor-nav">{"".join(nav_links)}</nav>
    </header>

    {render_today_panel(data, raw)}

    {since_block}

    <section id="summary">
      <h2>The story</h2>
      {render_story(summary)}
    </section>

    {render_season_roadmap(data)}

    <section id="kpis">
      <h2>Key numbers, explained</h2>
      <p class="section-lead">Each card has its plain-language name up top and the formal abbreviation in a small badge you can hover for the technical definition.</p>
      {render_kpis(kpis)}
    </section>

    <section id="actions">
      <h2>What to do</h2>
      <p class="section-lead">Actions ordered by time horizon. &quot;Today&quot; means the <em>remainder</em> of today — if you've already done a session, these are post-session instructions.</p>
      {render_recommendations(recs)}
    </section>

    {render_charts_section(raw, metrics)}

    <section id="experts">
      <h2>Deep dives <span class="muted" style="font-size:.8rem; font-weight: 400;">(click to expand)</span></h2>
      <p class="section-lead">Three specialist views of the same data. Each is independent — the overall story above is peak-lab's synthesis across all three.</p>
      {render_expert_section("metrics", "Training load", experts.get("metrics"))}
      {render_expert_section("activity", "Session quality", experts.get("activity"))}
      {render_expert_section("physiology", "Recovery and readiness", experts.get("physiology"))}
    </section>

    {render_open_questions(questions)}

    {render_glossary()}

    <footer>
      peak-lab · architecture derived from <a href="https://github.com/leonzzz435/garmin-ai-coach">leonzzz435/garmin-ai-coach</a> (MIT) ·
      training paces via Jack Daniels' VDOT formulas (Daniels &amp; Gilbert, 1979)
      <br>
      Profile excerpt: <em>{profile}</em>
    </footer>
  </div>
</body>
</html>
"""
    return html_body


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Render peak-lab analysis HTML")
    parser.add_argument("analysis", help="Path to analysis.json")
    parser.add_argument("output", help="Path to write HTML")
    parser.add_argument("--raw", default=None, help="Optional path to raw.json for charts")
    parser.add_argument("--metrics", default=None, help="Optional path to training-metrics.json (auto-discovered next to analysis.json)")
    parser.add_argument("--lab-zones", default=None, help="Optional path to lab-zones.json; enables the HR/pace-vs-lab-zones section (auto-discovered at ./data/lab-zones.json)")
    parser.add_argument("--raw90", default=None, help="Optional path to a wider (e.g. 90-day) raw.json for the HR/pace section (auto-discovered as raw-90d.json next to analysis.json)")
    parser.add_argument("--effort-details", default=None, help="Optional path to an effort-details dir; enables the durability (power-duration) section (auto-discovered as effort-details/ next to analysis.json)")
    args = parser.parse_args(argv[1:])

    src = Path(args.analysis)
    dst = Path(args.output)
    if not src.exists():
        print(f"error: input file not found: {src}", file=sys.stderr)
        return 1
    try:
        data = json.loads(src.read_text())
    except json.JSONDecodeError as e:
        print(f"error: invalid JSON in {src}: {e}", file=sys.stderr)
        return 1

    # Auto-discover raw.json next to analysis.json
    raw_path = Path(args.raw) if args.raw else (src.parent / "raw.json")
    raw_data: dict | None = None
    if raw_path.exists():
        try:
            raw_data = json.loads(raw_path.read_text())
        except Exception as e:
            print(f"warning: could not parse {raw_path}: {e} (charts will be omitted)", file=sys.stderr)
            raw_data = None

    # Auto-discover training-metrics.json next to analysis.json
    metrics_path = Path(args.metrics) if args.metrics else (src.parent / "training-metrics.json")
    metrics_data: dict | None = None
    if metrics_path.exists():
        try:
            metrics_data = json.loads(metrics_path.read_text())
        except Exception as e:
            print(f"warning: could not parse {metrics_path}: {e} (weekly chart will fall back to raw.json aggregation)", file=sys.stderr)
            metrics_data = None

    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(render_html(data, raw_data, metrics_data))

    # Optional: append the HR/pace-vs-lab-zones section. This is a bundled,
    # data-gated feature — it runs only when the training project supplies a
    # lab-zones file (default ./data/lab-zones.json) and a wider raw window
    # (default raw-90d.json next to analysis.json). Because the section is
    # (re)generated on every render, any later re-render of this HTML
    # reproduces it automatically — no caller needs to know it exists, and
    # downstream tools that re-render don't have to re-inject. The injector
    # is a separate uv/scipy
    # script, keeping this renderer stdlib-only. Failures are non-fatal: the
    # rest of the report stands on its own.
    lab_zones_path = Path(args.lab_zones) if args.lab_zones else Path("data/lab-zones.json")
    raw90_path = Path(args.raw90) if args.raw90 else (src.parent / "raw-90d.json")
    hrpace_script = Path(__file__).resolve().parent / "hrpace-lab-section"
    hrpace_added = False
    if lab_zones_path.exists() and raw90_path.exists() and hrpace_script.exists():
        try:
            r = subprocess.run(
                [str(hrpace_script), str(raw90_path), str(lab_zones_path), "--inject", str(dst)],
                capture_output=True, text=True,
            )
            if r.returncode == 0:
                hrpace_added = True
            else:
                print(f"warning: HR/pace-lab section skipped: {r.stderr.strip()}", file=sys.stderr)
        except Exception as e:
            print(f"warning: HR/pace-lab section skipped: {e}", file=sys.stderr)

    # Optional: append the durability (power-duration / Critical Speed) section,
    # injected AFTER the HR/pace section so it lands right below the scatter.
    # Data-gated on an effort-details dir (default effort-details/ next to
    # analysis.json), populated by bin/fetch-effort-details during analyze.
    # Regenerated on every render; non-fatal.
    effort_dir = Path(args.effort_details) if args.effort_details else (src.parent / "effort-details")
    durability_script = Path(__file__).resolve().parent / "durability-section"
    durability_added = False
    if effort_dir.is_dir() and any(effort_dir.glob("*.json")) and durability_script.exists():
        try:
            cmd = [str(durability_script), str(effort_dir), str(args.raw or (src.parent / "raw.json"))]
            if lab_zones_path.exists():
                cmd += ["--lab-zones", str(lab_zones_path)]
            cmd += ["--inject", str(dst)]
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode == 0 and "injected" in (r.stdout + r.stderr):
                durability_added = True
            elif r.returncode != 0:
                print(f"warning: durability section skipped: {r.stderr.strip()}", file=sys.stderr)
        except Exception as e:
            print(f"warning: durability section skipped: {e}", file=sys.stderr)

    size = dst.stat().st_size
    parts = []
    if raw_data:
        parts.append("charts")
    if metrics_data:
        parts.append("metrics")
    if hrpace_added:
        parts.append("hr/pace-lab")
    if durability_added:
        parts.append("durability")
    extras = " with " + "+".join(parts) if parts else ""
    print(f"wrote {dst} ({size} bytes{extras})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
