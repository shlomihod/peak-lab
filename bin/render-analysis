_ENUM_RE = None
_CAMEL_RE = None


def humanize_garmin_text(text: str) -> str:
    """Replace Garmin enums and camelCase field names with plain language.

    Two passes:
    1. ALL_CAPS_WITH_UNDERSCORES → known map or generic lowercase/space
    2. camelCaseFieldNames → known map or generic space-separated
    """
    if not isinstance(text, str) or not text:
        return text
    global _ENUM_RE, _CAMEL_RE
    if _ENUM_RE is None:
        import re
        _ENUM_RE = re.compile(r"\b[A-Z][A-Z0-9_]{2,}\b")
        _CAMEL_RE = re.compile(r"\b([a-z][a-zA-Z0-9]*[A-Z][a-zA-Z0-9]*)\b")

    def enum_repl(m):
        tok = m.group(0)
        if tok in _HUMANIZE_SKIP:
            return tok
        if tok in GARMIN_ENUM_HUMAN:
            return GARMIN_ENUM_HUMAN[tok]
        if "_" in tok:
            return tok.replace("_", " ").lower()
        return tok

    def camel_repl(m):
        tok = m.group(0)
        if tok in CAMEL_CASE_HUMAN:
            return CAMEL_CASE_HUMAN[tok]
        # Generic conversion: insert space before each uppercase letter then lowercase
        import re as _re
        out = _re.sub(r"([A-Z])", r" \1", tok).strip().lower()
        return out

    text = _ENUM_RE.sub(enum_repl, text)
    text = _CAMEL_RE.sub(camel_repl, text)
    return text


# ---------------------------------------------------------------------------
# KPI plain-language augmentation
# ---------------------------------------------------------------------------

def kpi_interpret(label: str, value: Any, status: str | None, trend: str | None) -> dict:
    """Return a dict with plain-language label, subtitle, and a one-line
    interpretation for a KPI based on its label and value."""
    lab = str(label).strip()
    low = lab.lower()
    v = str(value).strip() if value is not None else ""
    # Strip a leading "+" on standalone numerics. Plain positive numbers don't
    # need a sign, and a leading "+" is a common upstream tell for Form (TSB)
    # being written as "+N" when fatigue actually dominates (should be "-N").
    # We only strip it — we never flip sign — so a genuine positive still reads
    # correctly.
    if v.startswith("+") and len(v) > 1 and v[1].isdigit():
        v = v[1:]

    # Defaults
    out = {
        "plain_label": lab,
        "abbr": "",
        "definition": "",
        "value": v,
        "unit": "",
        "interpretation": "",
        "status": (status or "").lower() if status else "",
        "trend": trend or "",
    }

    if "acwr" in low or "strain" in low or "load strain" in low:
        out.update(plain_label="Load Strain Ratio", abbr="ACWR", definition=gdef("ACWR"))
        try:
            f = float(v.split()[0])
            if f < 0.8:
                out["interpretation"] = "Below sweet spot — you've eased off; detraining risk if sustained."
            elif f < 1.1:
                out["interpretation"] = "Sweet spot — fitness growing sustainably."
            elif f < 1.3:
                out["interpretation"] = "Productive — building hard but not risky."
            elif f < 1.5:
                out["interpretation"] = "High — keep an eye on recovery signals."
            else:
                out["interpretation"] = "Overreach zone — injury/illness risk rising."
        except Exception:
            pass
    elif low.startswith("ctl") or "fitness" == low or "chronic" in low:
        out.update(plain_label="Fitness", abbr="CTL", definition=gdef("CTL"))
        out["interpretation"] = "Your sustained training load. Rising = aerobic base is growing."
    elif low.startswith("atl") or low == "fatigue":
        out.update(plain_label="Fatigue", abbr="ATL", definition=gdef("ATL"))
        out["interpretation"] = "How tired you are right now from recent work."
    elif low.startswith("tsb") or "form" in low or "freshness" in low:
        out.update(plain_label="Form", abbr="TSB", definition=gdef("TSB"))
        try:
            f = float(v.split()[0])
            if f > 10:
                out["interpretation"] = "Fresh and ready — race-day territory."
            elif f > -20:
                out["interpretation"] = "Lightly fatigued — sustainable training state."
            elif f > -50:
                out["interpretation"] = "Training-block fatigue — expected during a build."
            else:
                out["interpretation"] = "Deep fatigue — recover before adding more."
        except Exception:
            pass
    elif "hrv" in low:
        out.update(plain_label="Heart Rate Variability", abbr="HRV", definition=gdef("HRV"))
        out["interpretation"] = "Autonomic recovery signal. Compare to your personal baseline."
    elif "readiness" in low:
        out.update(plain_label="Readiness", abbr="Readiness", definition=gdef("readiness"))
        try:
            numpart = v.split()[0]
            f = float(numpart)
            if f >= 75:
                out["interpretation"] = "Fresh — a hard session is supported."
            elif f >= 50:
                out["interpretation"] = "Moderate — easy to moderate work is fine."
            elif f >= 25:
                out["interpretation"] = "Low — prioritize recovery over intensity."
            else:
                out["interpretation"] = "Very low — rest or very easy movement only."
        except Exception:
            pass
    elif "rem" in low or "sleep" in low:
        out.update(plain_label="Sleep Quality", abbr="", definition=gdef("REM"))
        out["interpretation"] = "How your overnight recovery is trending."
    elif "spo2" in low or "blood oxygen" in low or "nadir" in low:
        out.update(plain_label="Blood Oxygen Pattern", abbr="SpO2", definition=gdef("SpO2"))
        out["interpretation"] = "Nocturnal oxygen lows. Recurring drops below 88% warrant clinical check."
    elif "vdot" in low or ("vo2" in low and "fitness" in low):
        out.update(plain_label="Daniels Score", abbr="VDOT", definition=gdef("VDOT"))
        out["interpretation"] = "Your current performance score driving training paces."
    elif "long" in low and "run" in low:
        out["plain_label"] = "Long Run Ceiling"
        out["interpretation"] = "Your longest recent run. Must progress toward 32–35 km for a marathon."
    elif "volume" in low or "weekly" in low:
        out["plain_label"] = "Weekly Volume"
        out["interpretation"] = "Training volume per week across all sports."
    elif "adherence" in low:
        out["plain_label"] = "Plan Adherence"
        out["interpretation"] = "How closely you're executing prescribed sessions."
    elif "easy" in low and ("drift" in low or "tempo" in low):
        out["plain_label"] = "Easy-Run Discipline"
        out["interpretation"] = "Fraction of 'easy' runs that drifted into tempo effort."
    elif "threshold" in low and "pace" in low:
        out["plain_label"] = "Threshold Pace"
        out["interpretation"] = "Your current functional threshold running pace."

    return out


# ---------------------------------------------------------------------------
# HTML helpers
# ---------------------------------------------------------------------------

def esc(x: Any) -> str:
    return html.escape(str(x)) if x is not None else ""


def esc_h(x: Any) -> str:
    """Escape + humanize Garmin enums. Use for user-facing text content."""
    if x is None:
        return ""
    return html.escape(humanize_garmin_text(str(x)))


STATUS_COLORS = {
    "green": "#22c55e",
    "amber": "#f59e0b",
    "yellow": "#f59e0b",
    "red": "#ef4444",
    "go": "#22c55e",
    "caution": "#f59e0b",
    "stop": "#ef4444",
}


def status_color(status: str | None) -> str:
    if not status:
        return "#64748b"
    return STATUS_COLORS.get(status.lower().strip(), "#64748b")


def traffic_light(text: str) -> tuple[str, str]:
    """Parse the first word of a traffic-light prefixed string.
    Returns (color_key, remaining_text)."""
    t = (text or "").lstrip()
    for kw in ("GREEN", "AMBER", "YELLOW", "RED"):
        if t.upper().startswith(kw):
            color = {"GREEN": "green", "AMBER": "amber", "YELLOW": "amber", "RED": "red"}[kw]
            rest = t[len(kw):].lstrip(" —-:").strip()
            return color, rest
    return "", t


def fmt_duration_sec(sec: float | int | None) -> str:
    if sec is None or sec == 0:
        return "0 min"
    s = int(sec)
    h, rem = divmod(s, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h {m:02d}m"
    return f"{m} min"


def fmt_km(m: float | int | None) -> str:
    if m is None:
        return "—"
    try:
        return f"{float(m) / 1000:.1f} km"
    except Exception:
        return "—"


def fmt_iso_date(s: str | None) -> str:
    if not s:
        return ""
    try:
        d = datetime.fromisoformat(s.replace("Z", "+00:00"))
        return d.strftime("%a %b %d, %Y %H:%M UTC")
    except Exception:
        return str(s)


# ---------------------------------------------------------------------------
# raw.json extractors
# ---------------------------------------------------------------------------

def extract_training_load_series(raw: dict) -> list[dict]:
    """Return a list of {date, atl, ctl, tsb, acwr} dicts in chronological order."""
    out: list[dict] = []
    ts = raw.get("training_status") or {}
    for d in sorted(ts.keys()):
        entry = ts[d]
        if not isinstance(entry, dict):
            continue
        try:
            latest = entry.get("mostRecentTrainingStatus", {}).get("latestTrainingStatusData", {})
            uk = next(iter(latest), None) if isinstance(latest, dict) else None
            if not uk:
                continue
            node = latest[uk]
            acute_dto = node.get("acuteTrainingLoadDTO", {}) if isinstance(node, dict) else {}
            atl = acute_dto.get("dailyTrainingLoadAcute")
            ctl = acute_dto.get("dailyTrainingLoadChronic")
            acwr = acute_dto.get("dailyAcuteChronicWorkloadRatio")
            tsb = None
            if atl is not None and ctl is not None:
                try:
                    tsb = float(ctl) - float(atl)
                except Exception:
                    tsb = None
            out.append({"date": d, "atl": atl, "ctl": ctl, "tsb": tsb, "acwr": acwr})
        except Exception:
            continue
    return out


def extract_hrv_series(raw: dict) -> list[dict]:
    """Return [{date, last_night, weekly_avg, balanced_low, balanced_high}]."""
    out: list[dict] = []
    h = raw.get("hrv") or {}
    for d in sorted(h.keys()):
        entry = h[d]
        if not isinstance(entry, dict):
            continue
        summary = entry.get("hrvSummary") or {}
        ln = summary.get("lastNightAvg")
        wa = summary.get("weeklyAvg")
        baseline = summary.get("baseline") or {}
        lo = baseline.get("balancedLow")
        hi = baseline.get("balancedUpper")
        out.append(
            {
                "date": d,
                "last_night": ln,
                "weekly_avg": wa,
                "balanced_low": lo,
                "balanced_high": hi,
            }
        )
    return out


def extract_sleep_series(raw: dict) -> list[dict]:
    """Return [{date, total_sec, deep_sec, light_sec, rem_sec, awake_sec}]."""
    out: list[dict] = []
    s = raw.get("sleep") or {}
    for d in sorted(s.keys()):
        entry = s[d]
        if not isinstance(entry, dict):
            continue
        dto = entry.get("dailySleepDTO") or {}
        out.append(
            {
                "date": d,
                "total_sec": dto.get("sleepTimeSeconds"),
                "deep_sec": dto.get("deepSleepSeconds"),
                "light_sec": dto.get("lightSleepSeconds"),
                "rem_sec": dto.get("remSleepSeconds"),
                "awake_sec": dto.get("awakeSleepSeconds"),
            }
        )
    return out


def extract_season_context(data: dict) -> dict | None:
    """Build a race-roadmap timeline context from analysis.json's plan field.

    Returns None when there are no races to plot. Otherwise returns a dict
    with `today`, `start`, `end` (ISO date strings) and `races` (list of
    {name, date, priority, target_time}).
    """
    import datetime as _dt
    today_iso = (data.get("generated_at") or _dt.datetime.now(_dt.timezone.utc).isoformat())[:10]
    races: list[dict] = []

    pl = data.get("plan") or {}
    anchor_date = pl.get("anchor_race_date") or pl.get("end")
    anchor_name = pl.get("anchor_race_name") or pl.get("name", "Race")
    anchor_target = pl.get("anchor_race_target")
    if anchor_date:
        races.append({
            "name": anchor_name,
            "date": anchor_date,
            "priority": "A",
            "target_time": anchor_target,
        })
    for r in (pl.get("races") or pl.get("additional_races") or []):
        if not isinstance(r, dict) or not r.get("date"):
            continue
        if any(x["date"] == r["date"] and x["name"] == r.get("name") for x in races):
            continue
        races.append({
            "name": r.get("name", "Race"),
            "date": r["date"],
            "priority": r.get("priority", ""),
            "target_time": r.get("target_time"),
        })

    if not races:
        return None

    races = sorted(races, key=lambda r: r.get("date") or "")
    return {
        "today": today_iso,
        "start": today_iso,
        "end": races[-1]["date"],
        "races": races,
    }


def chart_season_timeline(ctx: dict) -> str:
    """Horizontal season roadmap: macro phases + today marker + race pins."""
    if not ctx:
        return ""
    try:
        start = date.fromisoformat(ctx["start"])
        end = date.fromisoformat(ctx["end"])
        today = date.fromisoformat(ctx["today"])
    except Exception:
        return ""
    total_days = (end - start).days
    if total_days <= 0:
        return ""

    # Timeline layout (scaled to CHART_W)
    W = CHART_W
    H = 280
    pad_l = 20
    pad_r = 20
    pad_t = 30
    pad_b = 110
    bar_y = pad_t + 40
    bar_h = 46
    legend_y = bar_y + bar_h + 82

    def x_for(d: date) -> float:
        frac = (d - start).days / total_days
        frac = max(0.0, min(1.0, frac))
        return pad_l + frac * (W - pad_l - pad_r)

    RACE_COLORS = {"A": "#ef4444", "B": "#f59e0b", "C": "#60a5fa"}

    body = []

    # Title bar (subtle gray backing for full timeline)
    body.append(
        f'<rect x="{pad_l}" y="{bar_y}" width="{W - pad_l - pad_r}" height="{bar_h}" '
        f'fill="#e5e7eb" rx="6" />'
    )

    # Month labels along the axis (under the bar)
    month_cursor = date(start.year, start.month, 1)
    if month_cursor < start:
        pass
    # Walk through months from start to end
    d = date(start.year, start.month, 1)
    while d <= end:
        if d >= start:
            x = x_for(d)
            body.append(
                f'<line x1="{x:.1f}" y1="{bar_y + bar_h}" x2="{x:.1f}" '
                f'y2="{bar_y + bar_h + 6}" stroke="#4b5563" stroke-width="1" />'
            )
            mlabel = d.strftime("%b")
            body.append(
                f'<text x="{x:.1f}" y="{bar_y + bar_h + 20:.1f}" text-anchor="start" '
                f'font-size="10" fill="#9ca3af">{mlabel}</text>'
            )
        # Next month
        if d.month == 12:
            d = date(d.year + 1, 1, 1)
        else:
            d = date(d.year, d.month + 1, 1)

    # Race priority legend (right side only).
    present_prios = []
    for r in ctx["races"]:
        p = (r.get("priority") or "C").upper()
        if p not in RACE_COLORS:
            p = "C"
        if p not in present_prios:
            present_prios.append(p)
    present_prios.sort()
    if present_prios:
        rx_cursor = W - pad_r
        for p in reversed(present_prios):
            label_txt = f"{p} race"
            rx_cursor -= len(label_txt) * 7
            body.append(
                f'<text x="{rx_cursor:.1f}" y="{legend_y + 1:.1f}" font-size="11" '
                f'fill="#e5e7eb">{esc(label_txt)}</text>'
            )
            rx_cursor -= 8
            body.append(
                f'<circle cx="{rx_cursor:.1f}" cy="{legend_y - 3:.1f}" r="5" '
                f'fill="{RACE_COLORS[p]}" stroke="#0b0f17" stroke-width="1.5" />'
            )
            rx_cursor -= 12

    # Race pins
    for r in ctx["races"]:
        try:
            rd = date.fromisoformat(r["date"])
        except Exception:
            continue
        if rd < start or rd > end:
            continue
        rx = x_for(rd)
        priority = (r.get("priority") or "C").upper()
        if priority not in RACE_COLORS:
            priority = "C"
        pin_color = RACE_COLORS[priority]
        # Vertical line through the bar
        body.append(
            f'<line x1="{rx:.1f}" y1="{bar_y - 8}" x2="{rx:.1f}" '
            f'y2="{bar_y + bar_h + 2}" stroke="{pin_color}" stroke-width="2" stroke-dasharray="3 2" />'
        )
        # Pin circle above
        body.append(
            f'<circle cx="{rx:.1f}" cy="{bar_y - 12}" r="5" fill="{pin_color}" stroke="#0b0f17" stroke-width="1.5"/>'
        )
        # Label group — rotate ~35° for readability
        name = r.get("name", "")
        if len(name) > 18:
            name = name[:17] + "…"
        target = r.get("target_time") or ""
        label = name
        if target:
            label = f"{name} · target {target}"
        weeks_out = max(0, (rd - today).days) // 7
        weeks_suffix = f" ({weeks_out}w away)" if weeks_out > 0 else " (today!)" if weeks_out == 0 else ""
        body.append(
            f'<text x="{rx:.1f}" y="{pad_t - 4:.1f}" text-anchor="middle" '
            f'font-size="11" font-weight="600" fill="{pin_color}">'
            f'{esc(priority + " race: ")}{esc(name)}'
            f'</text>'
        )
        # Date + weeks-out label below pin label
        body.append(
            f'<text x="{rx:.1f}" y="{pad_t + 10:.1f}" text-anchor="middle" '
            f'font-size="10" fill="#9ca3af">'
            f'{esc(rd.strftime("%b %d"))}{esc(weeks_suffix)}'
            f'</text>'
        )

    # Today marker (drawn last so it's on top)
    if start <= today <= end:
        tx = x_for(today)
        body.append(
            f'<line x1="{tx:.1f}" y1="{bar_y - 22}" x2="{tx:.1f}" '
            f'y2="{bar_y + bar_h + 8}" stroke="#e5e7eb" stroke-width="2.5" />'
        )
        body.append(
            f'<polygon points="{tx-6:.1f},{bar_y - 22:.1f} {tx+6:.1f},{bar_y - 22:.1f} {tx:.1f},{bar_y - 12:.1f}" '
            f'fill="#e5e7eb"/>'
        )
        body.append(
            f'<text x="{tx:.1f}" y="{bar_y + bar_h + 50:.1f}" text-anchor="middle" '
            f'font-size="11" font-weight="700" fill="#e5e7eb">TODAY</text>'
        )
        body.append(
            f'<text x="{tx:.1f}" y="{bar_y + bar_h + 63:.1f}" text-anchor="middle" '
            f'font-size="10" fill="#9ca3af">{esc(today.strftime("%a %b %d"))}</text>'
        )

    return (
        f'<svg viewBox="0 0 {W} {H}" preserveAspectRatio="xMidYMid meet" '
        f'role="img" aria-label="Season roadmap timeline">'
        + "".join(body)
        + "</svg>"
    )


def extract_weekly_volume_by_sport(raw: dict, metrics: dict | None) -> list[dict]:
    """Aggregate activities into weekly per-sport volume (km + sessions).

    Prefers `training-metrics.json`'s `weekly[]` rollup when available, since
    that's the same sport-agnostic aggregation the experts read. Falls back to
    summing `raw.json.activities[]` directly for back-compat with old runs.

    Returns [{week_start, week_end, by_sport: {sport: {km, sessions}}, sessions}].
    Distance is included for sports where it's meaningful (running, cycling,
    hiking, walking, swimming); strength / mobility report sessions only.
    """
    # Preferred path: training-metrics.json
    if metrics:
        weekly = metrics.get("weekly") or []
        out = []
        for wk in weekly:
            if not isinstance(wk, dict):
                continue
            bys_in = wk.get("by_sport") or {}
            bys_out = {}
            total_sessions = 0
            for sport, vals in bys_in.items():
                if not isinstance(vals, dict):
                    continue
                bys_out[sport] = {
                    "km": float(vals.get("distance_km") or 0),
                    "sessions": int(vals.get("sessions") or 0),
                    "duration_min": float(vals.get("duration_min") or 0),
                }
                total_sessions += bys_out[sport]["sessions"]
            out.append(
                {
                    "week_start": wk.get("week_start"),
                    "week_end": wk.get("week_end"),
                    "by_sport": bys_out,
                    "sessions": total_sessions,
                }
            )
        return out

    # Fallback: aggregate from raw.json activities directly (older runs).
    acts = raw.get("activities") or []
    by_week: dict[str, dict] = {}
    for a in acts:
        if not isinstance(a, dict):
            continue
        at = a.get("activityType")
        tkey = at.get("typeKey") if isinstance(at, dict) else ""
        sport = _sport_bucket(tkey)
        raw_dt = a.get("startTimeLocal") or a.get("startTimeGMT") or ""
        if not isinstance(raw_dt, str) or len(raw_dt) < 10:
            continue
        try:
            d = date.fromisoformat(raw_dt[:10])
        except Exception:
            continue
        monday = d - timedelta(days=d.weekday())
        key = monday.isoformat()
        bucket = by_week.setdefault(
            key,
            {
                "week_start": monday.isoformat(),
                "week_end": (monday + timedelta(days=6)).isoformat(),
                "by_sport": {},
                "sessions": 0,
            },
        )
        sbucket = bucket["by_sport"].setdefault(
            sport, {"km": 0.0, "sessions": 0, "duration_min": 0.0}
        )
        try:
            sbucket["km"] += float(a.get("distance") or 0) / 1000.0
        except Exception:
            pass
        try:
            sbucket["duration_min"] += float(a.get("duration") or 0) / 60.0
        except Exception:
            pass
        sbucket["sessions"] += 1
        bucket["sessions"] += 1
    return [by_week[k] for k in sorted(by_week.keys())]


def find_today_activity(raw: dict, today_iso: str) -> dict | None:
    """Return the activity (if any) logged today in raw.json."""
    acts = raw.get("activities") or []
    best = None
    for a in acts:
        if not isinstance(a, dict):
            continue
        dt = a.get("startTimeLocal") or a.get("startTimeGMT") or ""
        if isinstance(dt, str) and dt[:10] == today_iso:
            # Prefer the latest one of the day
            if best is None or (a.get("startTimeLocal", "") > best.get("startTimeLocal", "")):
                best = a
    return best


# ---------------------------------------------------------------------------
# SVG chart helpers (pure inline SVG, no JS)
# ---------------------------------------------------------------------------

CHART_W = 900
CHART_H = 280
CHART_PAD_L = 50
CHART_PAD_R = 20
CHART_PAD_T = 20
CHART_PAD_B = 40


def _svg_scale_x(i: int, n: int) -> float:
    if n <= 1:
        return CHART_PAD_L
    usable = CHART_W - CHART_PAD_L - CHART_PAD_R
    return CHART_PAD_L + (i / (n - 1)) * usable


def _svg_scale_y(v: float, vmin: float, vmax: float) -> float:
    if vmax <= vmin:
        return CHART_H - CHART_PAD_B
    usable = CHART_H - CHART_PAD_T - CHART_PAD_B
    t = (v - vmin) / (vmax - vmin)
    return CHART_PAD_T + (1 - t) * usable


def _svg_axis(vmin: float, vmax: float, y_label: str, dates: list[str]) -> str:
    """Draw X/Y axes with 4-5 gridlines and tick labels."""
    out = []
    # Y gridlines
    steps = 4
    for i in range(steps + 1):
        v = vmin + (vmax - vmin) * (i / steps)
        y = _svg_scale_y(v, vmin, vmax)
        out.append(
            f'<line x1="{CHART_PAD_L}" y1="{y:.1f}" x2="{CHART_W - CHART_PAD_R}" y2="{y:.1f}" '
            f'stroke="#e5e7eb" stroke-width="1" />'
        )
        out.append(
            f'<text x="{CHART_PAD_L - 8}" y="{y + 4:.1f}" text-anchor="end" '
            f'font-size="11" fill="#9ca3af">{v:.0f}</text>'
        )
    # Y label
    out.append(
        f'<text x="12" y="{CHART_H / 2:.0f}" text-anchor="middle" '
        f'font-size="11" fill="#9ca3af" transform="rotate(-90 12 {CHART_H / 2:.0f})">{esc(y_label)}</text>'
    )
    # X ticks — show ~5 evenly spaced labels
    n = len(dates)
    if n > 0:
        tick_idx = [0, n // 4, n // 2, 3 * n // 4, n - 1] if n >= 5 else list(range(n))
        tick_idx = sorted(set(tick_idx))
        for i in tick_idx:
            x = _svg_scale_x(i, n)
            out.append(
                f'<line x1="{x:.1f}" y1="{CHART_H - CHART_PAD_B}" x2="{x:.1f}" '
                f'y2="{CHART_H - CHART_PAD_B + 4}" stroke="#4b5563" stroke-width="1" />'
            )
            d = dates[i]
            short = d[5:] if len(d) >= 10 else d  # MM-DD
            out.append(
                f'<text x="{x:.1f}" y="{CHART_H - CHART_PAD_B + 18}" text-anchor="middle" '
                f'font-size="10" fill="#9ca3af">{esc(short)}</text>'
            )
    return "".join(out)


def _svg_line(points: list[tuple[float, float]], color: str, width: float = 2.0, label: str = "") -> str:
    if not points:
        return ""
    pts_str = " ".join(f"{x:.1f},{y:.1f}" for x, y in points if not (math.isnan(y) or math.isinf(y)))
    if not pts_str:
        return ""
    title = f'<title>{esc(label)}</title>' if label else ""
    return (
        f'<polyline fill="none" stroke="{color}" stroke-width="{width}" '
        f'stroke-linejoin="round" stroke-linecap="round" points="{pts_str}">{title}</polyline>'
    )


def _svg_line_segments(
    series: list[tuple[float, float | None]],
    color: str,
    width: float = 2.0,
) -> str:
    """Draw a line that breaks around None values."""
    out = []
    current: list[tuple[float, float]] = []
    for x, y in series:
        if y is None:
            if len(current) >= 2:
                out.append(_svg_line(current, color, width))
            current = []
        else:
            current.append((x, y))
    if len(current) >= 2:
        out.append(_svg_line(current, color, width))
    return "".join(out)


def _svg_band(
    series_low: list[tuple[float, float | None]],
    series_high: list[tuple[float, float | None]],
    color: str,
    opacity: float = 0.15,
) -> str:
    """Shaded band between two lines (assumes same x values)."""
    if len(series_low) != len(series_high):
        return ""
    pts_low = [(x, y) for x, y in series_low if y is not None]
    pts_high = [(x, y) for x, y in series_high if y is not None]
    if len(pts_low) < 2 or len(pts_high) < 2:
        return ""
    poly = " ".join(f"{x:.1f},{y:.1f}" for x, y in pts_high)
    poly += " " + " ".join(f"{x:.1f},{y:.1f}" for x, y in reversed(pts_low))
    return f'<polygon fill="{color}" fill-opacity="{opacity}" points="{poly}" />'


def chart_training_load(series: list[dict]) -> str:
    """Build the training load timeline chart (CTL, ATL, TSB)."""
    pts = [s for s in series if s["atl"] is not None and s["ctl"] is not None]
    if len(pts) < 3:
        return ""
    dates = [s["date"] for s in pts]
    atls = [float(s["atl"]) for s in pts]
    ctls = [float(s["ctl"]) for s in pts]
    tsbs = [float(s["tsb"]) if s["tsb"] is not None else None for s in pts]

    all_vals = [v for v in atls + ctls + [t for t in tsbs if t is not None] if v is not None]
    if not all_vals:
        return ""
    vmin = min(all_vals) - 20
    vmax = max(all_vals) + 20

    n = len(dates)
    x_coords = [_svg_scale_x(i, n) for i in range(n)]

    atl_series = [(x_coords[i], _svg_scale_y(atls[i], vmin, vmax)) for i in range(n)]
    ctl_series = [(x_coords[i], _svg_scale_y(ctls[i], vmin, vmax)) for i in range(n)]
    tsb_series = [
        (x_coords[i], _svg_scale_y(tsbs[i], vmin, vmax) if tsbs[i] is not None else None)
        for i in range(n)
    ]

    # Zero line for TSB
    zero_y = _svg_scale_y(0, vmin, vmax) if vmin <= 0 <= vmax else None

    body = []
    body.append(_svg_axis(vmin, vmax, "Load", dates))
    if zero_y is not None:
        body.append(
            f'<line x1="{CHART_PAD_L}" y1="{zero_y:.1f}" x2="{CHART_W - CHART_PAD_R}" '
            f'y2="{zero_y:.1f}" stroke="#4b5563" stroke-width="1" stroke-dasharray="4 4" />'
        )
    body.append(_svg_line(ctl_series, "#14b8a6", 2.5, f"Fitness (CTL) on {dates[-1]}: {ctls[-1]:.0f}"))
    body.append(_svg_line(atl_series, "#f59e0b", 2.0, f"Fatigue (ATL) on {dates[-1]}: {atls[-1]:.0f}"))
    body.append(_svg_line_segments(tsb_series, "#a78bfa", 1.5))

    legend = (
        f'<g transform="translate({CHART_PAD_L + 10}, {CHART_PAD_T + 6})">'
        f'<rect x="0" y="-10" width="14" height="3" fill="#14b8a6"/><text x="20" y="-5" font-size="11" fill="#e5e7eb">Fitness</text>'
        f'<rect x="85" y="-10" width="14" height="3" fill="#f59e0b"/><text x="105" y="-5" font-size="11" fill="#e5e7eb">Fatigue</text>'
        f'<rect x="170" y="-10" width="14" height="3" fill="#a78bfa"/><text x="190" y="-5" font-size="11" fill="#e5e7eb">Form (fitness − fatigue)</text>'
        f'</g>'
    )
    body.append(legend)

    return (
        f'<svg viewBox="0 0 {CHART_W} {CHART_H}" preserveAspectRatio="xMidYMid meet" '
        f'role="img" aria-label="Training load timeline">'
        + "".join(body)
        + "</svg>"
    )


def chart_hrv(series: list[dict]) -> str:
    """HRV timeline with personal baseline band."""
    pts = [s for s in series if s["last_night"] is not None]
    if len(pts) < 3:
        return ""
    dates = [s["date"] for s in pts]
    ln = [float(s["last_night"]) for s in pts]
    wa = [float(s["weekly_avg"]) if s["weekly_avg"] is not None else None for s in pts]
    lo = [float(s["balanced_low"]) if s["balanced_low"] is not None else None for s in pts]
    hi = [float(s["balanced_high"]) if s["balanced_high"] is not None else None for s in pts]

    all_vals = [v for v in ln + [x for x in wa + lo + hi if x is not None]]
    if not all_vals:
        return ""
    vmin = max(0, min(all_vals) - 5)
    vmax = max(all_vals) + 5

    n = len(dates)
    x_coords = [_svg_scale_x(i, n) for i in range(n)]
    ln_series = [(x_coords[i], _svg_scale_y(ln[i], vmin, vmax)) for i in range(n)]
    wa_series = [
        (x_coords[i], _svg_scale_y(wa[i], vmin, vmax) if wa[i] is not None else None) for i in range(n)
    ]
    lo_series = [
        (x_coords[i], _svg_scale_y(lo[i], vmin, vmax) if lo[i] is not None else None) for i in range(n)
    ]
    hi_series = [
        (x_coords[i], _svg_scale_y(hi[i], vmin, vmax) if hi[i] is not None else None) for i in range(n)
    ]

    body = []
    body.append(_svg_axis(vmin, vmax, "HRV (ms)", dates))
    # Personal balanced range: neutral gray band so it's clearly
    # context, not a semantic signal competing with the lines.
    body.append(_svg_band(lo_series, hi_series, "#64748b", 0.18))
    body.append(_svg_line_segments(lo_series, "#94a3b8", 0.8))
    body.append(_svg_line_segments(hi_series, "#94a3b8", 0.8))
    # Weekly average: soft lavender smoothed trend
    body.append(_svg_line_segments(wa_series, "#c4b5fd", 1.5))
    # Last night: bright sky blue — the single primary signal
    body.append(_svg_line(ln_series, "#38bdf8", 2.5, f"Last night on {dates[-1]}: {ln[-1]:.0f} ms"))

    legend = (
        f'<g transform="translate({CHART_PAD_L + 10}, {CHART_PAD_T + 6})">'
        f'<rect x="0" y="-10" width="14" height="3" fill="#38bdf8"/><text x="20" y="-5" font-size="11" fill="#e5e7eb">Last night</text>'
        f'<rect x="100" y="-10" width="14" height="3" fill="#c4b5fd"/><text x="120" y="-5" font-size="11" fill="#e5e7eb">7-day average</text>'
        f'<rect x="205" y="-10" width="14" height="6" fill="#64748b" fill-opacity="0.35"/><text x="225" y="-5" font-size="11" fill="#e5e7eb">Your personal healthy range</text>'
        f'</g>'
    )
    body.append(legend)

    return (
        f'<svg viewBox="0 0 {CHART_W} {CHART_H}" preserveAspectRatio="xMidYMid meet" '
        f'role="img" aria-label="Heart rate variability timeline">'
        + "".join(body)
        + "</svg>"
    )


def chart_sleep(series: list[dict]) -> str:
    """Sleep duration per night as stacked bars (deep/light/REM/awake)."""
    pts = [s for s in series if s["total_sec"]]
    if len(pts) < 3:
        return ""
    dates = [s["date"] for s in pts]
    totals_h = [float(s["total_sec"] or 0) / 3600 for s in pts]

    vmax = max(12, max(totals_h) + 1)
    vmin = 0

    n = len(dates)
    bar_w = max(3, (CHART_W - CHART_PAD_L - CHART_PAD_R) / n * 0.8)

    body = []
    body.append(_svg_axis(vmin, vmax, "Hours", dates))

    # 6h floor line
    y6 = _svg_scale_y(6, vmin, vmax)
    body.append(
        f'<line x1="{CHART_PAD_L}" y1="{y6:.1f}" x2="{CHART_W - CHART_PAD_R}" y2="{y6:.1f}" '
        f'stroke="#ef4444" stroke-width="1" stroke-dasharray="4 4" />'
        f'<text x="{CHART_W - CHART_PAD_R - 4}" y="{y6 - 4:.1f}" text-anchor="end" font-size="10" fill="#ef4444">6h minimum</text>'
    )
    # 8h optimal
    y8 = _svg_scale_y(8, vmin, vmax)
    body.append(
        f'<line x1="{CHART_PAD_L}" y1="{y8:.1f}" x2="{CHART_W - CHART_PAD_R}" y2="{y8:.1f}" '
        f'stroke="#22c55e" stroke-width="1" stroke-dasharray="4 4" />'
        f'<text x="{CHART_W - CHART_PAD_R - 4}" y="{y8 - 4:.1f}" text-anchor="end" font-size="10" fill="#22c55e">8h target</text>'
    )

    for i, p in enumerate(pts):
        x = _svg_scale_x(i, n) - bar_w / 2
        # Stack: deep at bottom, light, REM, awake on top
        parts = [
            ("deep_sec", "#2563eb", "Deep"),
            ("light_sec", "#60a5fa", "Light"),
            ("rem_sec", "#a78bfa", "REM"),
            ("awake_sec", "#4b5563", "Awake"),
        ]
        y_cursor = _svg_scale_y(0, vmin, vmax)
        cumulative_h = 0.0
        title_parts = [f"{p['date']} total: {totals_h[i]:.1f}h"]
        for key, color, name in parts:
            sec = p.get(key) or 0
            try:
                hrs = float(sec) / 3600.0
            except Exception:
                hrs = 0.0
            if hrs <= 0:
                continue
            cumulative_h += hrs
            top_y = _svg_scale_y(cumulative_h, vmin, vmax)
            height = y_cursor - top_y
            body.append(
                f'<rect x="{x:.1f}" y="{top_y:.1f}" width="{bar_w:.1f}" height="{height:.1f}" '
                f'fill="{color}" />'
            )
            title_parts.append(f"{name}: {hrs:.1f}h")
            y_cursor = top_y
        # Title for hover
        full_title = " / ".join(title_parts)
        body.append(
            f'<rect x="{x:.1f}" y="{_svg_scale_y(cumulative_h, vmin, vmax):.1f}" '
            f'width="{bar_w:.1f}" height="{_svg_scale_y(0, vmin, vmax) - _svg_scale_y(cumulative_h, vmin, vmax):.1f}" '
            f'fill="transparent"><title>{esc(full_title)}</title></rect>'
        )

    legend = (
        f'<g transform="translate({CHART_PAD_L + 10}, {CHART_PAD_T + 6})">'
        f'<rect x="0" y="-10" width="10" height="10" fill="#2563eb"/><text x="16" y="-1" font-size="11" fill="#e5e7eb">Deep</text>'
        f'<rect x="65" y="-10" width="10" height="10" fill="#60a5fa"/><text x="81" y="-1" font-size="11" fill="#e5e7eb">Light</text>'
        f'<rect x="130" y="-10" width="10" height="10" fill="#a78bfa"/><text x="146" y="-1" font-size="11" fill="#e5e7eb">REM</text>'
        f'<rect x="195" y="-10" width="10" height="10" fill="#4b5563"/><text x="211" y="-1" font-size="11" fill="#e5e7eb">Awake</text>'
        f'</g>'
    )
    body.append(legend)

    return (
        f'<svg viewBox="0 0 {CHART_W} {CHART_H}" preserveAspectRatio="xMidYMid meet" '
        f'role="img" aria-label="Nightly sleep duration">'
        + "".join(body)
        + "</svg>"
    )


def chart_weekly_volume(weeks: list[dict]) -> str:
    """Weekly training volume — stacked per sport.

    Each week's bar stacks km from every distance-bearing sport (running,
    cycling, hiking, walking, swimming). Strength / mobility / etc. are
    session-only and appear in the hover tooltip; they don't have km to
    stack. A small chip above the bar reports total non-distance sessions
    so cross-training is visible at a glance.
    """
    if len(weeks) < 2:
        return ""

    # Per-week stack data
    stacks: list[list[tuple[str, float]]] = []
    tooltips: list[str] = []
    sessions_only_counts: list[int] = []
    week_totals_km: list[float] = []
    sports_used: set[str] = set()

    for w in weeks:
        bys = w.get("by_sport") or {}
        # Distance-bearing sports stacked in fixed bucket order
        layers: list[tuple[str, float]] = []
        for sport in _SPORT_BUCKETS:
            if sport not in DISTANCE_SPORTS:
                continue
            v = bys.get(sport)
            if not v:
                continue
            km = float(v.get("km") or 0)
            if km > 0:
                layers.append((sport, km))
                sports_used.add(sport)
        stacks.append(layers)
        week_totals_km.append(sum(km for _, km in layers))

        # Session-only sports: count strength/mobility/rowing/etc. for the chip.
        sess_only = 0
        sess_only_parts = []
        for sport, vals in bys.items():
            if sport in DISTANCE_SPORTS:
                continue
            if not isinstance(vals, dict):
                continue
            n = int(vals.get("sessions") or 0)
            if n > 0:
                sess_only += n
                sess_only_parts.append(f"{n} {sport.replace('_', ' ')}")
                sports_used.add(sport)
        sessions_only_counts.append(sess_only)

        # Tooltip: detailed sport breakdown
        tooltip_parts = [f"Week of {w['week_start']}"]
        for sport, km in layers:
            n = int((bys.get(sport) or {}).get("sessions") or 0)
            tooltip_parts.append(f"  {sport.replace('_', ' ')}: {km:.1f} km / {n} sessions")
        for part in sess_only_parts:
            tooltip_parts.append(f"  {part}")
        tooltips.append("\n".join(tooltip_parts))

    labels = [w["week_start"][5:] for w in weeks]  # MM-DD
    vmax = max(week_totals_km + [0]) * 1.2 + 5
    vmin = 0
    n = len(weeks)
    bar_w = max(10, (CHART_W - CHART_PAD_L - CHART_PAD_R) / n * 0.7)

    body = []
    body.append(_svg_axis(vmin, vmax, "km / week", labels))

    for i, w in enumerate(weeks):
        x = _svg_scale_x(i, n) - bar_w / 2
        y_baseline = _svg_scale_y(0, vmin, vmax)
        running_y = y_baseline  # bottom of the next layer to draw
        for sport, km in stacks[i]:
            layer_height = y_baseline - _svg_scale_y(km, vmin, vmax)
            seg_top = running_y - layer_height
            body.append(
                f'<rect x="{x:.1f}" y="{seg_top:.1f}" width="{bar_w:.1f}" '
                f'height="{layer_height:.1f}" fill="{_SPORT_COLORS.get(sport, "#9ca3af")}" rx="2">'
                f'<title>{esc(tooltips[i])}</title></rect>'
            )
            running_y = seg_top

        # Total km label above bar (running total of distance-bearing sports)
        total_km = week_totals_km[i]
        if total_km > 0:
            top_y = _svg_scale_y(total_km, vmin, vmax)
            body.append(
                f'<text x="{x + bar_w / 2:.1f}" y="{top_y - 4:.1f}" text-anchor="middle" '
                f'font-size="10" fill="#e5e7eb">{total_km:.0f}</text>'
            )

        # Cross-training chip for session-only sports (strength, mobility, etc.)
        sess_only = sessions_only_counts[i]
        if sess_only > 0:
            chip_y = _svg_scale_y(0, vmin, vmax) - 1
            body.append(
                f'<text x="{x + bar_w / 2:.1f}" y="{chip_y + 12:.1f}" text-anchor="middle" '
                f'font-size="9" fill="#475569">+{sess_only}x</text>'
            )

    # Legend across the top — only sports that actually appear in the window.
    legend_items = []
    lx = CHART_PAD_L
    legend_y = CHART_PAD_T - 8
    if legend_y < 14:
        legend_y = 14
    for sport in _SPORT_BUCKETS:
        if sport not in sports_used:
            continue
        color = _SPORT_COLORS.get(sport, "#9ca3af")
        label = sport.replace("_", " ")
        legend_items.append(
            f'<rect x="{lx:.1f}" y="{legend_y - 8:.1f}" width="10" height="10" fill="{color}" rx="2"/>'
            f'<text x="{lx + 14:.1f}" y="{legend_y + 1:.1f}" font-size="10" fill="#475569">{esc(label)}</text>'
        )
        lx += 14 + 10 + len(label) * 6 + 14

    return (
        f'<svg viewBox="0 0 {CHART_W} {CHART_H}" preserveAspectRatio="xMidYMid meet" '
        f'role="img" aria-label="Weekly training volume by sport">'
        + "".join(legend_items)
        + "".join(body)
        + "</svg>"
    )


# ---------------------------------------------------------------------------
# Section renderers
# ---------------------------------------------------------------------------

def render_today_panel(data: dict, raw: dict | None) -> str:
    """Hero panel: traffic light + today's session + primary call-to-action."""
    experts = data.get("experts") or {}
    phys = experts.get("physiology") or {}
    weekly_text = phys.get("for_weekly_planner") or phys.get("for_synthesis") or ""
    color_key, _ = traffic_light(weekly_text)
    if not color_key:
        kpis = data.get("kpis") or []
        statuses = [(k.get("status") or "").lower() for k in kpis if isinstance(k, dict)]
        if "red" in statuses:
            color_key = "red"
        elif "amber" in statuses or "yellow" in statuses:
            color_key = "amber"
        else:
            color_key = "green"

    color = status_color(color_key)
    light_label = {"green": "GO", "amber": "CAUTION", "red": "HOLD"}.get(color_key, "—")

    today_session_html = ""
    if raw:
        today_iso = (data.get("generated_at") or datetime.now(timezone.utc).isoformat())[:10]
        session = find_today_activity(raw, today_iso)
        if session:
            raw_name = session.get("activityName") or session.get("activityType", {}).get("typeKey", "session")
            # Humanize FIRST, then title-case — don't title-case a raw enum
            # like LACTATE_THRESHOLD because that produces "Lactate_Threshold"
            # which the humanizer won't match.
            name = esc(humanize_garmin_text(raw_name).title() if raw_name else "")
            raw_effect = session.get("trainingEffectLabel") or ""
            effect = esc(humanize_garmin_text(raw_effect).title() if raw_effect else "")
            dur = fmt_duration_sec(session.get("duration"))
            dist = fmt_km(session.get("distance"))
            hr = session.get("averageHR")
            hr_part = f' · {int(hr)} bpm avg' if hr else ""
            today_session_html = (
                f'<div class="today-session">'
                f'<div class="done">✓ Today&#39;s session — done</div>'
                f'<div class="session-name">{name}</div>'
                f'<div class="session-meta">{effect} · {dur} · {dist}{hr_part}</div>'
                f'</div>'
            )
        else:
            today_session_html = (
                f'<div class="today-session no-session">'
                f'<div class="done muted">No session logged today yet</div>'
                f'</div>'
            )

    # Primary call to action: today recommendation (short form if available)
    recs = data.get("recommendations") or []
    today_rec = next((r for r in recs if isinstance(r, dict) and (r.get("horizon") or "").lower() == "today"), None)
    rec_html = ""
    if today_rec:
        text = today_rec.get("text_short") or today_rec.get("text", "")
        rec_html = (
            f'<div class="cta">'
            f'<div class="cta-label">What to do next</div>'
            f'<div class="cta-text">{esc_h(text)}</div>'
            f'</div>'
        )

    return f"""
    <section class="today-panel" id="today">
      <div class="light" style="background:{color}">
        <div class="light-label">{light_label}</div>
        <div class="light-sub">Readiness</div>
      </div>
      <div class="today-content">
        {today_session_html}
        {rec_html}
      </div>
    </section>
    """


def render_kpis(kpis: list[dict]) -> str:
    if not kpis:
        return "<p class='empty'>No key numbers reported.</p>"
    cards = []
    for k in kpis:
        if not isinstance(k, dict):
            continue
        info = kpi_interpret(
            label=k.get("label", ""),
            value=k.get("value", ""),
            status=k.get("status"),
            trend=k.get("trend"),
        )
        # Prefer explicit fields from the analysis.json when present
        if k.get("label"):
            info["plain_label"] = k["label"]
        if k.get("abbr"):
            info["abbr"] = k["abbr"]
        note = esc_h(k.get("note", ""))
        source = esc_h(k.get("source", ""))
        status_class = f"status-{info['status']}" if info["status"] else ""
        trend_arrow = ""
        if info["trend"]:
            t = info["trend"].lower()
            if "ris" in t:
                trend_arrow = "↗"
            elif "fall" in t:
                trend_arrow = "↘"
            elif "stead" in t:
                trend_arrow = "→"

        abbr_badge = ""
        if info["abbr"] and info["abbr"] != info["plain_label"]:
            # CSS-based tooltip (browser `title` attr is unreliable on some platforms)
            defn = info.get("definition", "") or gdef(info["abbr"])
            if defn:
                abbr_badge = (
                    f'<span class="tip" tabindex="0">{esc(info["abbr"])}'
                    f'<span class="tip-body">{esc(defn)}</span></span>'
                )
            else:
                abbr_badge = f'<span class="abbr-plain">{esc(info["abbr"])}</span>'

        interp = esc_h(info['interpretation']) if info['interpretation'] else note
        cards.append(
            f"""
            <div class="kpi {status_class}">
              <div class="kpi-head">
                <div class="kpi-label">
                  {esc_h(info['plain_label'])}
                  {abbr_badge}
                </div>
              </div>
              <div class="kpi-value">{esc_h(info['value'])} <span class="trend">{trend_arrow}</span></div>
              <div class="kpi-interp">{interp}</div>
              {f'<div class="kpi-note">{note}</div>' if (note and info['interpretation'] and note != info['interpretation']) else ''}
              {f'<div class="kpi-source">Source: {source}</div>' if source else ''}
            </div>
            """
        )
    return '<div class="kpi-grid">' + "".join(cards) + "</div>"


def render_recommendations(recs: list[dict]) -> str:
    if not recs:
        return "<p class='empty'>No actions listed.</p>"

    priority_order = ["today", "tomorrow", "this_week", "next_4_weeks"]
    labels = {
        "today": ("Today", "the rest of today"),
        "tomorrow": ("Tomorrow", "next 24 hours"),
        "this_week": ("This week", "next 7 days"),
        "next_4_weeks": ("Next 4 weeks", "28-day guardrails"),
    }
    by_horizon: dict[str, dict] = {}
    for r in recs:
        if not isinstance(r, dict):
            continue
        h = (r.get("horizon") or "").lower().strip()
        by_horizon[h] = r

    out = ['<div class="recs">']
    for h in priority_order:
        if h in by_horizon:
            r = by_horizon[h]
            title, sub = labels[h]
            text_short = r.get("text_short") or r.get("text", "")
            text_full = r.get("text", "")
            short_html = esc_h(text_short)
            # Only show "More detail" disclosure if full text is longer than short
            details_html = ""
            if text_full and text_full != text_short and len(text_full) > len(text_short) + 20:
                details_html = (
                    f'<details class="rec-details"><summary>More detail</summary>'
                    f'<div class="rec-full">{esc_h(text_full)}</div></details>'
                )
            out.append(
                f'<div class="rec rec-{h}">'
                f'<div class="rec-head"><span class="rec-title">{title}</span>'
                f'<span class="rec-sub">{sub}</span></div>'
                f'<div class="rec-text">{short_html}</div>'
                f'{details_html}'
                f'</div>'
            )
    # Any remaining horizons not in priority list
    for h, r in by_horizon.items():
        if h not in priority_order:
            out.append(
                f'<div class="rec rec-other">'
                f'<div class="rec-head"><span class="rec-title">{esc(h.title().replace("_"," "))}</span></div>'
                f'<div class="rec-text">{esc_h(r.get("text",""))}</div>'
                f'</div>'
            )
    out.append("</div>")
    return "".join(out)


def render_signals(signals: list[dict]) -> str:
    if not signals:
        return '<p class="empty">No signals.</p>'
    rows = []
    for s in signals:
        if not isinstance(s, dict):
            continue
        rows.append(
            f"""
            <div class="signal">
              <div class="signal-name">{esc_h(s.get('signal',''))}</div>
              <div class="signal-body">
                <div><span class="label">Evidence</span> {esc_h(s.get('evidence',''))}</div>
                <div><span class="label">What it means</span> {esc_h(s.get('implication',''))}</div>
                <div class="uncertainty"><span class="label">Uncertainty</span> {esc_h(s.get('uncertainty',''))}</div>
              </div>
            </div>
            """
        )
    return '<div class="signals">' + "".join(rows) + "</div>"


def render_expert_section(name: str, plain_name: str, expert: dict | None) -> str:
    if not expert:
        return ""
    synthesis = esc_h(expert.get("for_synthesis", ""))
    weekly = esc_h(expert.get("for_weekly_planner", ""))
    signals = expert.get("signals", []) or []
    return f"""
    <details class="expert">
      <summary><span class="expert-name">{esc(plain_name)}</span> <span class="expert-sub">{esc(name)} view</span></summary>
      <div class="expert-body">
        <div class="expert-block">
          <h4>Current state</h4>
          <p>{synthesis or '<em class="muted">No synthesis.</em>'}</p>
        </div>
        {f'<div class="expert-block"><h4>For the next 7 days</h4><p>{weekly}</p></div>' if weekly else ''}
        <div class="expert-block">
          <h4>Key signals</h4>
          {render_signals(signals)}
        </div>
      </div>
    </details>
    """


def render_since_last_run(data: dict) -> str:
    """Delta preamble — what changed since the prior analysis run.

    Returns empty string when the field is absent, null, or points at a first
    run (no prior_run_at). Skips cleanly so the caller can interpolate
    unconditionally.
    """
    since = data.get("since_last_run")
    if not isinstance(since, dict):
        return ""
    prior_at = since.get("prior_run_at")
    if not prior_at:
        return ""

    headline = since.get("headline") or ""
    transition = (since.get("physiology_transition") or "unchanged").lower()
    new_sigs = [s for s in (since.get("new_signals") or []) if s]
    resolved = [s for s in (since.get("resolved_signals") or []) if s]
    new_acts = [a for a in (since.get("new_activities") or []) if a]
    hours = since.get("hours_since")

    transition_badges = {
        "green_to_amber": ("→ AMBER", "amber"),
        "green_to_red": ("→ RED", "red"),
        "amber_to_red": ("→ RED", "red"),
        "amber_to_green": ("→ GREEN", "green"),
        "red_to_amber": ("→ AMBER", "amber"),
        "red_to_green": ("→ GREEN", "green"),
        "unchanged": ("unchanged", "muted"),
    }
    badge_text, badge_cls = transition_badges.get(transition, ("unchanged", "muted"))

    prior_label = fmt_iso_date(prior_at)
    if isinstance(hours, (int, float)) and hours >= 0:
        prior_label = f"{prior_label} ({hours:.1f}h ago)"

    def col(head: str, items: list[str]) -> str:
        if not items:
            return ""
        lis = "".join(f"<li>{esc_h(s)}</li>" for s in items[:3])
        return f'<div class="since-col"><h4>{esc(head)}</h4><ul>{lis}</ul></div>'

    columns = "".join([
        col("New signals", new_sigs),
        col("Resolved", resolved),
        col("New activities", new_acts),
    ])
    columns_block = f'<div class="since-cols">{columns}</div>' if columns else ""

    return f"""
    <section id="since-last">
      <div class="since-card">
        <div class="since-head">
          <span class="since-label">Since last run</span>
          <span class="since-prior">{esc(prior_label)}</span>
          <span class="since-badge since-badge-{badge_cls}">{esc(badge_text)}</span>
        </div>
        <div class="since-headline">{esc_h(headline)}</div>
        {columns_block}
      </div>
    </section>
    """


def render_open_questions(qs: list[str]) -> str:
    if not qs:
        return ""
    items = "".join(f"<li>{esc_h(q)}</li>" for q in qs if q)
    return f"""
    <section id="open-questions">
      <h2>Open questions</h2>
      <p class="section-lead">Patterns (not one-off events) that would materially change your plan if resolved. Worth revisiting at the next analysis.</p>
      <ol class="open-questions">{items}</ol>
    </section>
    """


def render_glossary() -> str:
    """Collapsible glossary at the end of the report."""
    items = []
    for abbr, (plain, defn) in sorted(GLOSSARY.items(), key=lambda x: x[1][0]):
        items.append(
            f'<div class="glossary-item">'
            f'<div class="glossary-head"><span class="glossary-plain">{esc(plain)}</span>'
            f'<span class="glossary-abbr">{esc(abbr)}</span></div>'
            f'<div class="glossary-def">{esc(defn)}</div>'
            f'</div>'
        )
    return f"""
    <details class="glossary" id="glossary">
      <summary><span class="glossary-title">Glossary</span> <span class="muted">— every technical term used in this report, in plain language</span></summary>
      <div class="glossary-grid">{"".join(items)}</div>
    </details>
    """


def render_season_roadmap(data: dict) -> str:
    """Race-roadmap timeline: upcoming races + you-are-here marker on a date axis."""
    ctx = extract_season_context(data)
    if not ctx:
        return ""
    chart = chart_season_timeline(ctx)
    if not chart:
        return ""

    return f"""
    <section id="roadmap">
      <h2>Road to the race</h2>
      <p class="section-lead">Every upcoming race pinned on a timeline from today forward. Pin colors mark priority — A (red), B (amber), C (blue) — with the number of weeks until each.</p>
      <div class="chart-panel">
        <div class="chart-body">{chart}</div>
      </div>
    </section>
    """


def render_charts_section(raw: dict | None, metrics: dict | None = None) -> str:
    if not raw:
        return ""
    tl_series = extract_training_load_series(raw)
    hrv_series = extract_hrv_series(raw)
    sleep_series = extract_sleep_series(raw)
    weekly_vol = extract_weekly_volume_by_sport(raw, metrics)

    tl_chart = chart_training_load(tl_series)
    hrv_chart = chart_hrv(hrv_series)
    sleep_chart = chart_sleep(sleep_series)
    vol_chart = chart_weekly_volume(weekly_vol)

    if not any([tl_chart, hrv_chart, sleep_chart, vol_chart]):
        return ""

    def panel(title: str, sub: str, svg: str) -> str:
        if not svg:
            return ""
        return (
            f'<div class="chart-panel">'
            f'<div class="chart-head"><h3>{esc(title)}</h3><p class="chart-sub">{esc(sub)}</p></div>'
            f'<div class="chart-body">{svg}</div>'
            f'</div>'
        )

    return f"""
    <section id="charts">
      <h2>What the data looks like</h2>
      <p class="section-lead">Every chart below is generated from the same Garmin data that fed the experts. Hover individual points for exact values.</p>
      {panel(
        "Training load over time",
        "Fitness (teal) should rise steadily. Fatigue (amber) spikes after hard days and drops with rest. Form (purple) is Fitness minus Fatigue — positive means fresh, negative means in-training.",
        tl_chart,
      )}
      {panel(
        "Overnight recovery",
        "The blue line is last night's heart rate variability (your recovery signal). The lavender line is the 7-day smoothed average. The gray band is your personal healthy range. Drops below the band are crash-territory, especially two nights in a row.",
        hrv_chart,
      )}
      {panel(
        "Sleep per night",
        "Total hours with stage breakdown (deep → light → REM → awake). The red line is the 6-hour minimum; the green line is the 8-hour target. Two consecutive nights under the red line is a known crash pattern for you.",
        sleep_chart,
      )}
      {panel(
        "Weekly training volume",
        "Kilometres per Monday-starting week, stacked by sport (running + cycling + hiking + walking + swimming). Strength and mobility sessions don't have km to stack, so they appear as a +Nx chip below the bar. Healthy progression is ≤10% increase week-over-week in total load; any single jump beyond 15% raises overuse risk.",
        vol_chart,
      )}
    </section>
    """


