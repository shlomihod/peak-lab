#!/usr/bin/env python3
"""
render-analysis v2: turn analysis.json into a self-contained HTML dashboard.

Design goals:
- Plain-language labels for every technical term, with tooltips for the
  formal abbreviation (ACWR, CTL, TSB, HRV, etc.)
- Inline SVG time-series charts (training load, HRV, sleep, weekly volume)
  generated from raw.json if it can be found next to analysis.json
- Progressive disclosure: headline first, deep-dive experts collapsed by
  default via native <details> elements — no JavaScript
- Hero "Today" panel acknowledging any session already logged today
- Mobile-friendly responsive CSS grid
- Glossary at the bottom for every term used

Usage:
    render-analysis <analysis.json> <output.html> [--raw RAW_JSON]

If --raw is not provided, the script looks for `raw.json` in the same
directory as <analysis.json>. Without raw.json, the charts section is
silently omitted and the rest of the report still renders.

Zero external dependencies — stdlib only.
"""

from __future__ import annotations

import argparse
import html
import json
import math
import subprocess
import sys
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import Any

# Shared sport-bucket mapping. Lives next to this script so the renderer's
# fallback aggregation (when training-metrics.json is absent) uses the same
# buckets / colors / distance-sports tuple as the helper that produces the
# metrics file.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from peak_lab_sports import (  # noqa: E402
    BUCKETS as _SPORT_BUCKETS,
    COLORS as _SPORT_COLORS,
    DISTANCE_SPORTS,
    bucket_for as _sport_bucket,
)

